{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile, role, active status, and permissions",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "username": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "role": { "type": "string", "enum": ["Admin", "Sales Officer"] },
        "active": { "type": "boolean" },
        "permissions": {
          "type": "object",
          "properties": {
            "Dashboard": { "type": "string", "enum": ["None", "View", "Full"] },
            "Sales": { "type": "string", "enum": ["None", "View", "Full"] },
            "Repair": { "type": "string", "enum": ["None", "View", "Full"] },
            "Settings": { "type": "string", "enum": ["None", "View", "Full"] }
          }
        },
        "phone": { "type": "string" },
        "bio": { "type": "string" },
        "avatarUrl": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["name", "username", "role", "active", "permissions"]
    },
    "Sale": {
      "title": "Sale",
      "description": "Sales record and invoice",
      "type": "object",
      "properties": {
        "item": { "type": "string" },
        "category": { "type": "string" },
        "qty": { "type": "number" },
        "amount": { "type": "number" },
        "paymentMethod": { "type": "string" },
        "date": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["item", "amount"]
    },
    "Repair": {
      "title": "Repair",
      "description": "Repair job ticket",
      "type": "object",
      "properties": {
        "customer": { "type": "string" },
        "phone": { "type": "string" },
        "device": { "type": "string" },
        "issue": { "type": "string" },
        "cost": { "type": "number" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["customer", "device"]
    },
    "Counter": {
      "title": "Counter",
      "description": "Sequential counter for invoices and job tickets",
      "type": "object",
      "properties": {
        "count": { "type": "number" }
      },
      "required": ["count"]
    },
    "AppConfig": {
      "title": "App Branding Config",
      "description": "Global branding settings for the application",
      "type": "object",
      "properties": {
        "sidebarLogoUrl": { "type": "string" },
        "sidebarName": { "type": "string" },
        "loginImageUrl": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "updatedBy": { "type": "string" }
      }
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile data linked by auth UID"
    },
    "/sales/{saleId}": {
      "schema": "Sale",
      "description": "Sales invoices"
    },
    "/repairs/{repairId}": {
      "schema": "Repair",
      "description": "Repair tickets"
    },
    "/counters/{counterId}": {
      "schema": "Counter",
      "description": "Invoice and ticket sequential ID counters"
    },
    "/settings/{docId}": {
      "schema": "AppConfig",
      "description": "Global branding and application settings"
    },
    "/test/connection": {
      "schema": { "$ref": "#/entities/AppConfig" },
      "description": "Connection test document"
    }
  }
}
